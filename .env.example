# Copy to .env (never commit .env). All values are optional for local development.
# Settings file (default: config/sentinel.yaml)
SENTINEL_CONFIG=config/sentinel.yaml
# SQLite database path (overrides db_path in the settings file)
SENTINEL_DB_PATH=var/sentinel.db
# dev | test | prod. prod refuses to start without SENTINEL_SIGNING_KEY.
SENTINEL_ENV=dev
# HMAC key for authorization tokens, at least 32 characters. Without it an ephemeral per-process key is used,
# so tokens issued by one process (e.g. the API) cannot be verified by another (e.g. the CLI).
SENTINEL_SIGNING_KEY=
